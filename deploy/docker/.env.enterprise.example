# ============================================================
# Enterprise AI Knowledge Assistant - 企业部署环境配置
# 使用方式：复制到 dify/docker/ 目录并改名 .env（覆盖默认项）
#   1) git clone --depth 1 https://github.com/langgenius/dify dify
#   2) copy 本文件到 dify/docker/.env
#   3) cd dify/docker && docker compose up -d
#   4) 访问 http://localhost/install 完成初始化
# ============================================================

# ---------- 基础 ----------
# 版本固定（与 analysis/ARCHITECTURE.md 分析基线一致，镜像 tag 由 docker-compose 指定）
# DIFY_VERSION=1.17.1

# 站点标题（前端浏览器标题，不影响应用名称）
APP_ID=
# 控制台显示名称
CONSOLE_API_URL=http://localhost
CONSOLE_WEB_URL=http://localhost
SERVICE_API_URL=http://localhost

# ---------- 向量库（Weaviate，开箱即用；生产可按需切换 Qdrant / pgvector） ----------
VECTOR_STORE=weaviate
WEAVIATE_ENDPOINT=http://weaviate:8080
WEAVIATE_API_KEY=WVF5YThaHlkYwhGUSmCRgsX3tD5ngdN8pkih

# ---------- 主数据库（PostgreSQL） ----------
DB_USERNAME=postgres
DB_PASSWORD=difyai123456
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify

# ---------- 缓存 / 队列 ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=difyai123456
REDIS_DB=0
CELERY_BROKER_URL=redis://:difyai123456@redis:6379/1

# ---------- 密钥（生产环境务必改为随机强口令） ----------
SECRET_KEY=sk-enterprise-ai-knowledge-assistant-2026
SECURITY_COMMIT_SHA=

# ---------- 模型接入（示例：OpenAI 兼容接口，可替换为 DeepSeek / 火山方舟 / Ollama 等） ----------
# 在控制台「设置 → 模型供应商」中配置后即可使用；
# 本文件仅预留环境变量，不硬编码模型密钥。
# OPENAI_API_KEY=
# OPENAI_API_BASE=

# ---------- 存储（默认 opendal，与本机目录绑定；保持官方默认即可） ----------
STORAGE_TYPE=opendal

# ---------- 其他（安全 / 限流 / 日志） ----------
LOG_LEVEL=INFO
MULTIMODAL_SEND_FORMAT=base64
SSRF_PROXY_HTTP_URL=http://ssrf_proxy:3128
SSRF_PROXY_HTTPS_URL=http://ssrf_proxy:3128
