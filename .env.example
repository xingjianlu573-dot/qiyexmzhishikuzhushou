# ============================================================
# Enterprise AI Knowledge Assistant - 环境变量示例（含国内部署项）
# 用法：
#   1) 拉取上游 Dify：git clone --depth 1 https://github.com/langgenius/dify dify
#   2) 将本文件内容合并到 dify/docker/.env（键名与官方 .env.example 一致）
#   3) docker compose up -d
# 完整国内部署步骤见 README_CN.md
# ============================================================

# ---------- 1. 站点地址 ----------
# 本地部署保持 localhost；公网/云服务器部署请替换为你的域名或 IP（需开放 80/443）
CONSOLE_API_URL=http://localhost
CONSOLE_WEB_URL=http://localhost
SERVICE_API_URL=http://localhost

# ---------- 2. 安全密钥（生产环境务必改为随机强口令） ----------
SECRET_KEY=sk-enterprise-ai-knowledge-assistant-2026
# 管理员账号密码在首次访问 /install 时设置，不在此配置

# ---------- 3. 数据存储（默认本地，无国外依赖） ----------
# 主库 PostgreSQL（docker-compose 内网互通，保持官方默认）
DB_USERNAME=postgres
DB_PASSWORD=difyai123456
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify

# 缓存 / 队列
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=difyai123456
REDIS_DB=0
CELERY_BROKER_URL=redis://:difyai123456@redis:6379/1

# 向量库（默认 Weaviate，本地容器；可换 Qdrant / pgvector，均本地化）
VECTOR_STORE=weaviate
WEAVIATE_ENDPOINT=http://weaviate:8080
WEAVIATE_API_KEY=WVF5YThaHlkYwhGUSmCRgsX3tD5ngdN8pkih

# 文件存储（本地磁盘）
STORAGE_TYPE=opendal

# ---------- 4. 模型供应商（国内推荐，重点） ----------
# 说明：Dify 平台本身即「AI Provider 抽象层」，支持 40+ 模型供应商；
# 模型凭据推荐在控制台「设置 → 模型供应商」中配置（存入数据库，界面可视化切换），
# 无需修改任何代码。国内直连推荐（任一即可）：
#   - DeepSeek（deepseek-chat / deepseek-reasoner）
#   - 阿里云百炼·通义千问（qwen-plus / qwen-turbo 等）
#   - 智谱 AI（glm-4-flash / glm-4-plus 等，开放平台 BigModel）
#   - 月之暗面 Kimi（moonshot-v1-8k 等）
# 各供应商接入步骤见 docs/CN_MODEL_PROVIDERS.md
#
# 可选：若你使用 OpenAI 兼容接口（含国内 OpenAI 兼容网关），可在此预设：
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_API_BASE=https://api.openai.com/v1   # 国内请改为兼容网关地址

# ---------- 5. 网络与国内访问优化 ----------
# Docker 镜像加速：将 deploy/docker/daemon.mirrors.example.json 内容
# 合并到 Docker 的 /etc/docker/daemon.json（Linux）或 Docker Desktop 设置（Windows/macOS）
#
# 可选：关闭 Dify 更新检查（默认会请求国外 updates.dify.ai，不影响核心功能）
# CHECK_UPDATE_URL=
# 可选：插件市场默认请求 marketplace.dify.ai，如网络受限可在控制台关闭或忽略

# ---------- 6. 本项目初始化脚本参数（seed-kb.py） ----------
# 部署完成后创建数据集 API Key 填入：
# DIFY_SERVICE_API_URL=http://localhost/v1
# DIFY_DATASET_API_KEY=dataset-xxxxxxxxxxxxxxxx

# ---------- 7. 其他（官方默认，可按需调整） ----------
LOG_LEVEL=INFO
NGINX_PORT=80
EXPOSE_NGINX_PORT=80
